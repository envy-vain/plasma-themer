// {{ name }} — generated by plasma-themer. Put your own tweaks in ~/.config/fastfetch/config.jsonc instead.
{
  "$schema": "https://github.com/fastfetch-cli/fastfetch/raw/dev/doc/json_schema.json",
  "logo": { "color": { "1": "{{ c.accent }}", "2": "{{ c.magenta }}" }, "padding": { "right": 2 } },
  "display": {
    "separator": "  ",
    "color": { "keys": "{{ c.accent }}", "title": "{{ c.magenta }}", "output": "{{ c.foreground }}" }
  },
  "modules": [
    "title",
    { "type": "custom", "format": "\u001b[38;2;{{ c.border | rgb | replace(',', ';') }}m─────────────────────────────" },
    { "type": "os", "key": " os" },
    { "type": "kernel", "key": " kernel" },
    { "type": "uptime", "key": "󰅐 uptime" },
    { "type": "packages", "key": "󰏖 pkgs" },
    { "type": "de", "key": " de" },
    { "type": "wm", "key": " wm" },
    { "type": "terminal", "key": " term" },
    { "type": "cpu", "key": " cpu" },
    { "type": "gpu", "key": "󰢮 gpu" },
    { "type": "memory", "key": " mem" },
    { "type": "disk", "key": "󰋊 disk" },
    { "type": "battery", "key": "󰁹 bat" },
    { "type": "custom", "format": "\u001b[38;2;{{ c.border | rgb | replace(',', ';') }}m─────────────────────────────" },
    { "type": "custom", "format": "󰏘 {{ name }}" },
    "colors"
  ]
}
