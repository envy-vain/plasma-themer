{%- set bg = c.background -%}
{%- set fg = c.foreground -%}
{%- set view = c.dark_background -%}
{%- set inactive_fg = c.dark_foreground -%}
{%- macro common(back, alt) -%}
BackgroundAlternate={{ alt | rgb }}
BackgroundNormal={{ back | rgb }}
DecorationFocus={{ c.accent | rgb }}
DecorationHover={{ c.accent | mix(fg, 0.25) | rgb }}
ForegroundActive={{ c.accent | rgb }}
ForegroundInactive={{ inactive_fg | rgb }}
ForegroundLink={{ c.blue | rgb }}
ForegroundNegative={{ c.red | rgb }}
ForegroundNeutral={{ c.yellow | rgb }}
ForegroundNormal={{ fg | rgb }}
ForegroundPositive={{ c.green | rgb }}
ForegroundVisited={{ c.magenta | rgb }}
{%- endmacro %}
# Generated by plasma-themer ({{ name }}). Edit themes/{{ slug }}/colors.toml instead.
[ColorEffects:Disabled]
Color={{ bg | rgb }}
ColorAmount=0.55
ColorEffect=3
ContrastAmount=0.65
ContrastEffect=0
IntensityAmount=0.1
IntensityEffect=0

[ColorEffects:Inactive]
ChangeSelectionColor=true
Color={{ bg | rgb }}
ColorAmount=0.025
ColorEffect=0
ContrastAmount=0.1
ContrastEffect=0
Enable=false
IntensityAmount=0
IntensityEffect=0

[Colors:Button]
{{ common(c.surface2, c.surface) }}

[Colors:Complementary]
{{ common(c.darker_background, c.dark_background) }}

[Colors:Header]
{{ common(c.darker_background, c.dark_background) }}

[Colors:Header][Inactive]
{{ common(c.darker_background, c.dark_background) }}

[Colors:Selection]
BackgroundAlternate={{ c.accent | mix(bg, 0.3) | rgb }}
BackgroundNormal={{ c.accent | rgb }}
DecorationFocus={{ c.accent | rgb }}
DecorationHover={{ c.accent | rgb }}
ForegroundActive={{ c.accent_foreground | rgb }}
ForegroundInactive={{ c.accent_foreground | mix(c.accent, 0.3) | rgb }}
ForegroundLink={{ c.accent_foreground | rgb }}
ForegroundNegative={{ c.red | mix(c.accent_foreground, 0.5) | rgb }}
ForegroundNeutral={{ c.yellow | mix(c.accent_foreground, 0.5) | rgb }}
ForegroundNormal={{ c.accent_foreground | rgb }}
ForegroundPositive={{ c.green | mix(c.accent_foreground, 0.5) | rgb }}
ForegroundVisited={{ c.accent_foreground | rgb }}

[Colors:Tooltip]
{{ common(c.darker_background, c.dark_background) }}

[Colors:View]
{{ common(view, bg) }}

[Colors:Window]
{{ common(bg, c.lighter_background) }}

[General]
ColorScheme={{ scheme_id }}
Name={{ name }} (themer)
shadeSortColumn=true

[KDE]
contrast=4

[WM]
activeBackground={{ c.darker_background | rgb }}
activeBlend={{ fg | rgb }}
activeForeground={{ fg | rgb }}
inactiveBackground={{ c.darker_background | rgb }}
inactiveBlend={{ inactive_fg | rgb }}
inactiveForeground={{ inactive_fg | rgb }}
