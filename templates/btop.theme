# {{ name }} — generated by plasma-themer
theme[main_bg]="{{ c.background }}"
theme[main_fg]="{{ c.foreground }}"
theme[title]="{{ c.bright_foreground }}"
theme[hi_fg]="{{ c.accent }}"
theme[selected_bg]="{{ c.selection }}"
theme[selected_fg]="{{ c.bright_foreground }}"
theme[inactive_fg]="{{ c.muted }}"
theme[graph_text]="{{ c.dark_foreground }}"
theme[meter_bg]="{{ c.surface2 }}"
theme[proc_misc]="{{ c.accent }}"
theme[cpu_box]="{{ c.accent }}"
theme[mem_box]="{{ c.green }}"
theme[net_box]="{{ c.magenta }}"
theme[proc_box]="{{ c.yellow }}"
theme[div_line]="{{ c.border }}"
theme[temp_start]="{{ c.green }}"
theme[temp_mid]="{{ c.yellow }}"
theme[temp_end]="{{ c.red }}"
theme[cpu_start]="{{ c.accent }}"
theme[cpu_mid]="{{ c.magenta }}"
theme[cpu_end]="{{ c.red }}"
theme[free_start]="{{ c.green | mix(c.background, 0.5) }}"
theme[free_mid]="{{ c.green | mix(c.background, 0.25) }}"
theme[free_end]="{{ c.green }}"
theme[cached_start]="{{ c.cyan | mix(c.background, 0.5) }}"
theme[cached_mid]="{{ c.cyan | mix(c.background, 0.25) }}"
theme[cached_end]="{{ c.cyan }}"
theme[available_start]="{{ c.yellow | mix(c.background, 0.5) }}"
theme[available_mid]="{{ c.yellow | mix(c.background, 0.25) }}"
theme[available_end]="{{ c.yellow }}"
theme[used_start]="{{ c.red | mix(c.background, 0.5) }}"
theme[used_mid]="{{ c.red | mix(c.background, 0.25) }}"
theme[used_end]="{{ c.red }}"
theme[download_start]="{{ c.blue | mix(c.background, 0.5) }}"
theme[download_mid]="{{ c.blue | mix(c.background, 0.25) }}"
theme[download_end]="{{ c.blue }}"
theme[upload_start]="{{ c.magenta | mix(c.background, 0.5) }}"
theme[upload_mid]="{{ c.magenta | mix(c.background, 0.25) }}"
theme[upload_end]="{{ c.magenta }}"
theme[process_start]="{{ c.accent }}"
theme[process_mid]="{{ c.magenta }}"
theme[process_end]="{{ c.red }}"
