" {{ name }} — generated by plasma-themer
set background=dark
hi clear
if exists('syntax_on') | syntax reset | endif
let g:colors_name = 'themer'
set termguicolors

function! s:hi(group, fg, bg, attr)
  exe 'hi ' . a:group . ' guifg=' . a:fg . ' guibg=' . a:bg . ' gui=' . a:attr . ' cterm=' . a:attr
endfunction

call s:hi('Normal',       '{{ c.foreground }}', '{{ c.background }}', 'NONE')
call s:hi('NonText',      '{{ c.muted }}', 'NONE', 'NONE')
call s:hi('LineNr',       '{{ c.muted }}', 'NONE', 'NONE')
call s:hi('CursorLineNr', '{{ c.accent }}', 'NONE', 'bold')
call s:hi('CursorLine',   'NONE', '{{ c.surface }}', 'NONE')
call s:hi('Visual',       'NONE', '{{ c.selection }}', 'NONE')
call s:hi('Search',       '{{ c.background }}', '{{ c.yellow }}', 'NONE')
call s:hi('IncSearch',    '{{ c.background }}', '{{ c.accent }}', 'NONE')
call s:hi('StatusLine',   '{{ c.foreground }}', '{{ c.surface2 }}', 'NONE')
call s:hi('StatusLineNC', '{{ c.muted }}', '{{ c.surface }}', 'NONE')
call s:hi('VertSplit',    '{{ c.border }}', 'NONE', 'NONE')
call s:hi('Pmenu',        '{{ c.foreground }}', '{{ c.surface2 }}', 'NONE')
call s:hi('PmenuSel',     '{{ c.accent_foreground }}', '{{ c.accent }}', 'NONE')
call s:hi('MatchParen',   '{{ c.accent }}', 'NONE', 'bold,underline')
call s:hi('Comment',      '{{ c.dark_foreground }}', 'NONE', 'italic')
call s:hi('Constant',     '{{ c.orange }}', 'NONE', 'NONE')
call s:hi('String',       '{{ c.green }}', 'NONE', 'NONE')
call s:hi('Number',       '{{ c.orange }}', 'NONE', 'NONE')
call s:hi('Identifier',   '{{ c.cyan }}', 'NONE', 'NONE')
call s:hi('Function',     '{{ c.blue }}', 'NONE', 'NONE')
call s:hi('Statement',    '{{ c.magenta }}', 'NONE', 'NONE')
call s:hi('Keyword',      '{{ c.magenta }}', 'NONE', 'NONE')
call s:hi('PreProc',      '{{ c.cyan }}', 'NONE', 'NONE')
call s:hi('Type',         '{{ c.yellow }}', 'NONE', 'NONE')
call s:hi('Special',      '{{ c.accent }}', 'NONE', 'NONE')
call s:hi('Title',        '{{ c.accent }}', 'NONE', 'bold')
call s:hi('Error',        '{{ c.red }}', 'NONE', 'bold')
call s:hi('ErrorMsg',     '{{ c.red }}', 'NONE', 'bold')
call s:hi('WarningMsg',   '{{ c.yellow }}', 'NONE', 'NONE')
call s:hi('Todo',         '{{ c.background }}', '{{ c.yellow }}', 'bold')
call s:hi('DiffAdd',      '{{ c.green }}', '{{ c.surface }}', 'NONE')
call s:hi('DiffDelete',   '{{ c.red }}', '{{ c.surface }}', 'NONE')
call s:hi('DiffChange',   '{{ c.yellow }}', '{{ c.surface }}', 'NONE')
