/* plasma-themer: {{ name }} — generated */
Notification {
    background: {{ c.dark_background }};
    color: {{ c.foreground }};
    border: 1px solid {{ c.border }};
    border-left: 3px solid {{ c.accent }};
    border-radius: 10px;
    margin: 0;
}
QLabel { color: {{ c.foreground }}; }
#appLabel { font-weight: bold; color: {{ c.accent }}; }
#summaryLabel { font-weight: bold; color: {{ c.bright_foreground }}; }
#closeButton { margin: 3px; padding: 3px; border: none; border-radius: 6px; }
#closeButton:hover { background: {{ c.surface2 }}; }
QPushButton {
    background: {{ c.surface2 }}; color: {{ c.foreground }}; border: none; border-radius: 6px; padding: 4px 10px;
}
QPushButton:hover { background: {{ c.accent }}; color: {{ c.accent_foreground }}; }
