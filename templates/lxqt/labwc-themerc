# plasma-themer: {{ name }} — generated themerc-override, edits are overwritten on the next theme switch
border.width: 1
padding.width: 8
padding.height: 6
titlebar.height: 30

window.active.border.color: {{ c.accent | mix(c.background, 0.35) }}
window.inactive.border.color: {{ c.border }}
window.active.indicator.toggled-keybind.color: {{ c.red }}

window.active.title.bg.color: {{ c.dark_background }}
window.inactive.title.bg.color: {{ c.darker_background }}
window.active.label.text.color: {{ c.bright_foreground }}
window.inactive.label.text.color: {{ c.muted }}
window.label.text.justify: center

window.active.button.unpressed.image.color: {{ c.foreground }}
window.inactive.button.unpressed.image.color: {{ c.muted }}
window.active.button.close.unpressed.image.color: {{ c.red }}
window.active.button.hover.bg.color: {{ c.surface2 }}
window.button.width: 28
window.button.spacing: 4
window.button.hover.bg.corner-radius: 7

window.active.shadow.size: {{ 0 if lite else 40 }}
window.inactive.shadow.size: {{ 0 if lite else 22 }}
window.active.shadow.color: #00000099
window.inactive.shadow.color: #00000066

menu.border.width: 1
menu.border.color: {{ c.border }}
menu.items.bg.color: {{ c.dark_background }}
menu.items.text.color: {{ c.foreground }}
menu.items.active.bg.color: {{ c.accent }}
menu.items.active.text.color: {{ c.accent_foreground }}
menu.items.padding.x: 10
menu.items.padding.y: 6
menu.separator.color: {{ c.border }}
menu.title.bg.color: {{ c.surface }}
menu.title.text.color: {{ c.accent }}

osd.bg.color: {{ c.dark_background }}
osd.border.color: {{ c.accent }}
osd.border.width: 1
osd.label.text.color: {{ c.foreground }}
osd.window-switcher.style-classic.item.active.bg.color: {{ c.surface2 }}
osd.window-switcher.style-classic.item.active.border.color: {{ c.accent }}
osd.workspace-switcher.boxes.width: 20
osd.workspace-switcher.boxes.height: 20

snapping.overlay.region.bg.color: {{ c.accent | alpha(0.25) }}
snapping.overlay.edge.bg.color: {{ c.accent | alpha(0.25) }}
snapping.overlay.region.border.color: {{ c.accent }}
snapping.overlay.edge.border.color: {{ c.accent }}
